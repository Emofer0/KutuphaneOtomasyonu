@model KutuphaneOtomasyonu.Models.Kitaplar

@{
    ViewData["Title"] = "Kitap Detayı";
}

<div class="container py-5">
    @if (TempData["Basarili"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Basarili"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Hata"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card border-0 shadow">
        <div class="card-header text-white p-4"
             style="background-color:#102a4c;">

            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-1">@Model.Baslik</h1>

                    <p class="mb-0 opacity-75">
                        Kitap detayları
                    </p>
                </div>

                @if (Model.MevcutAdet > 0)
                {
                    <span class="badge bg-success fs-6">
                        Mevcut
                    </span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">
                        Stokta Yok
                    </span>
                }
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">ISBN</dt>
                        <dd class="col-sm-8">@Model.Isbn</dd>

                        <dt class="col-sm-4">Kitap Adı</dt>
                        <dd class="col-sm-8">@Model.Baslik</dd>

                        <dt class="col-sm-4">Yazar</dt>
                        <dd class="col-sm-8">
                            @(Model.Yazar?.AdSoyad ?? "-")
                        </dd>

                        <dt class="col-sm-4">Kategori</dt>
                        <dd class="col-sm-8">
                            @(Model.Kategori?.Baslik ?? "-")
                        </dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Raf Konumu</dt>
                        <dd class="col-sm-8">@Model.RafKonumu</dd>

                        <dt class="col-sm-4">Toplam Adet</dt>
                        <dd class="col-sm-8">@Model.ToplamAdet</dd>

                        <dt class="col-sm-4">Mevcut Adet</dt>
                        <dd class="col-sm-8">@Model.MevcutAdet</dd>
                    </dl>
                </div>
            </div>

            <hr />

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Kitaplara Dön
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.KitapId"
                       class="btn btn-warning">
                        Kitabı Düzenle
                    </a>
                }

                @if (User.IsInRole("Uye") && Model.MevcutAdet <= 0)
                {
                    <form asp-controller="Rezervasyonlar"
                          asp-action="Ayirt"
                          method="post">

                        <input type="hidden"
                               name="kitapId"
                               value="@Model.KitapId" />

                        <button type="submit"
                                class="btn btn-primary"
                                onclick="return confirm('Bu kitabı ayırtmak istediğinize emin misiniz?')">
                            Kitabı Ayırt
                        </button>
                    </form>
                }
            </div>

            @if (User.IsInRole("Uye") && Model.MevcutAdet > 0)
            {
                <div class="alert alert-info mt-4 mb-0">
                    Bu kitap şu anda kütüphanede mevcut olduğu için
                    rezervasyon yapılamaz.
                </div>
            }
        </div>
    </div>
</div>