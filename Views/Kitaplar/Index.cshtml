@model IEnumerable<KutuphaneOtomasyonu.Models.Kitaplar>

@{
    ViewData["Title"] = "Kitaplar";
    var adminMi = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Kitaplar</h1>

    @if (adminMi)
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Yeni Kitap Ekle
        </a>
    }
</div>

@if (TempData["BasariliMesaj"] != null)
{
    <div class="alert alert-success">
        @TempData["BasariliMesaj"]
    </div>
}

@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">
        @TempData["HataMesaji"]
    </div>
}

<form asp-action="Index"
      method="get"
      class="mb-4">

    <div class="input-group">
        <input type="text"
               name="arama"
               value="@ViewBag.Arama"
               class="form-control"
               placeholder="Kitap, ISBN, yazar, kategori veya raf ara..." />

        <button type="submit"
                class="btn btn-primary">
            Ara
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Temizle
        </a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        Arama kriterine uygun kitap bulunamadı.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ISBN</th>
                    <th>Kitap Adı</th>
                    <th>Yazar</th>
                    <th>Kategori</th>
                    <th>Raf</th>
                    <th>Toplam</th>
                    <th>Mevcut</th>
                    <th>Durum</th>

                    @if (adminMi)
                    {
                        <th>İşlemler</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Isbn</td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@item.KitapId"
                               class="text-decoration-none">
                                @item.Baslik
                            </a>
                        </td>

                        <td>@item.Yazar?.AdSoyad</td>
                        <td>@item.Kategori?.Baslik</td>
                        <td>@item.RafKonumu</td>
                        <td>@item.ToplamAdet</td>
                        <td>@item.MevcutAdet</td>

                        <td>
                            @if (item.MevcutAdet > 0)
                            {
                                <span class="badge bg-success">
                                    Mevcut
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Stokta Yok
                                </span>
                            }
                        </td>

                        @if (adminMi)
                        {
                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@item.KitapId"
                                   class="btn btn-warning btn-sm">
                                    Düzenle
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.KitapId"
                                   class="btn btn-info btn-sm">
                                    Detay
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.KitapId"
                                   class="btn btn-danger btn-sm">
                                    Sil
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}