@model KutuphaneOtomasyonu.ViewModels.SifreDegistirViewModel

@{
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <span class="badge bg-primary mb-3">
                        Hesap Güvenliği
                    </span>

                    <h1 class="h2">Şifre Değiştir</h1>

                    <p class="text-muted">
                        Hesabınızı korumak için güçlü ve
                        daha önce kullanmadığınız bir şifre belirleyin.
                    </p>
                </div>

                @if (TempData["BasariliMesaj"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["BasariliMesaj"]
                    </div>
                }

                <form asp-action="SifreDegistir"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="MevcutSifre"
                               class="form-label"></label>

                        <input asp-for="MevcutSifre"
                               class="form-control form-control-lg"
                               autocomplete="current-password"
                               autofocus />

                        <span asp-validation-for="MevcutSifre"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="YeniSifre"
                               class="form-label"></label>

                        <input asp-for="YeniSifre"
                               class="form-control form-control-lg"
                               autocomplete="new-password" />

                        <span asp-validation-for="YeniSifre"
                              class="text-danger"></span>

                        <div class="form-text">
                            Yeni şifre en az 6 karakter olmalıdır.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="YeniSifreTekrar"
                               class="form-label"></label>

                        <input asp-for="YeniSifreTekrar"
                               class="form-control form-control-lg"
                               autocomplete="new-password" />

                        <span asp-validation-for="YeniSifreTekrar"
                              class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit"
                                class="btn btn-primary btn-lg">
                            Şifreyi Değiştir
                        </button>

                        <a asp-controller="Kitaplar"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Vazgeç
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}