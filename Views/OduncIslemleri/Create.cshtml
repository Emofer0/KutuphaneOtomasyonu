@model KutuphaneOtomasyonu.Models.OduncIslemleri

@{
    ViewData["Title"] = "Kitap Ödünç Ver";
}

<h1>Kitap Ödünç Ver</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="KitapId" class="form-label">
                    Kitap
                </label>

                <select asp-for="KitapId"
                        class="form-select"
                        asp-items="ViewBag.KitapId">
                    <option value="">Kitap seçiniz</option>
                </select>

                <span asp-validation-for="KitapId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UyeId" class="form-label">
                    Üye
                </label>

                <select asp-for="UyeId"
                        class="form-select"
                        asp-items="ViewBag.UyeId">
                    <option value="">Üye seçiniz</option>
                </select>

                <span asp-validation-for="UyeId"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Ödünç Ver
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Listeye Dön
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}