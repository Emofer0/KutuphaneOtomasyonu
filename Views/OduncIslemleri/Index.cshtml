@model IEnumerable<KutuphaneOtomasyonu.Models.OduncIslemleri>

@{
    ViewData["Title"] = "Ödünç İşlemleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ödünç İşlemleri</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Yeni Ödünç İşlemi
    </a>
</div>

@if (TempData["BasariliMesaj"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["BasariliMesaj"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["HataMesaji"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="btn-group flex-wrap"
             role="group">

            <a asp-action="Index"
               asp-route-arama="@ViewBag.Arama"
               class="btn @(string.IsNullOrEmpty(ViewBag.Durum)
                   ? "btn-dark"
                   : "btn-outline-dark")">
                Tümü
            </a>

            <a asp-action="Index"
               asp-route-durum="oduncte"
               asp-route-arama="@ViewBag.Arama"
               class="btn @(ViewBag.Durum == "oduncte"
                   ? "btn-warning"
                   : "btn-outline-warning")">
                Ödünçte
            </a>

            <a asp-action="Index"
               asp-route-durum="geciken"
               asp-route-arama="@ViewBag.Arama"
               class="btn @(ViewBag.Durum == "geciken"
                   ? "btn-danger"
                   : "btn-outline-danger")">
                Geciken
            </a>

            <a asp-action="Index"
               asp-route-durum="iade"
               asp-route-arama="@ViewBag.Arama"
               class="btn @(ViewBag.Durum == "iade"
                   ? "btn-success"
                   : "btn-outline-success")">
                İade Edilenler
            </a>
        </div>
    </div>

    <div class="col-lg-5">
        <form asp-action="Index"
              method="get">

            <input type="hidden"
                   name="durum"
                   value="@ViewBag.Durum" />

            <div class="input-group">
                <input type="text"
                       name="arama"
                       value="@ViewBag.Arama"
                       class="form-control"
                       placeholder="Kitap veya üye ara..." />

                <button type="submit"
                        class="btn btn-primary">
                    Ara
                </button>

                <a asp-action="Index"
                   asp-route-durum="@ViewBag.Durum"
                   class="btn btn-secondary">
                    Temizle
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Seçilen kriterlere uygun ödünç işlemi bulunamadı.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Kitap</th>
                    <th>Üye</th>
                    <th>Veriliş Tarihi</th>
                    <th>Son Teslim Tarihi</th>
                    <th>İade Tarihi</th>
                    <th>Ceza</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    bool geciktiMi =
                        !item.TeslimEdildiMi &&
                        item.SonTeslimTarihi.Date <
                        DateTime.Today;

                    bool gecikmeliIadeEdildi =
                        item.TeslimEdildiMi &&
                        item.IadeTarihi.HasValue &&
                        item.IadeTarihi.Value.Date >
                        item.SonTeslimTarihi.Date;

                    int gecikmeGunSayisi = geciktiMi
                        ? (DateTime.Today -
                           item.SonTeslimTarihi.Date).Days
                        : 0;

                    int gecikmeliIadeGunSayisi =
                        gecikmeliIadeEdildi
                            ? (item.IadeTarihi!.Value.Date -
                               item.SonTeslimTarihi.Date).Days
                            : 0;

                    decimal guncelCeza = geciktiMi
                        ? gecikmeGunSayisi * 5
                        : item.CezaTutari;

                    <tr class="@(geciktiMi || gecikmeliIadeEdildi
                        ? "table-danger"
                        : "")">

                        <td>
                            <a asp-controller="Kitaplar"
                               asp-action="Details"
                               asp-route-id="@item.KitapId">
                                @item.Kitap?.Baslik
                            </a>
                        </td>

                        <td>
                            <a asp-controller="Uyeler"
                               asp-action="Details"
                               asp-route-id="@item.UyeId">
                                @item.Uye?.AdSoyad
                            </a>
                        </td>

                        <td>
                            @item.VerilisTarihi.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @item.SonTeslimTarihi.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @if (item.IadeTarihi.HasValue)
                            {
                                                              @item.IadeTarihi.Value.ToString("dd.MM.yyyy")
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>
                            @guncelCeza.ToString("N2")
                            <span>TL</span>

                            @if (geciktiMi)
                            {
                                <div class="small text-danger">
                                    Tahmini ceza
                                </div>
                            }
                        </td>

                        <td>
                            @if (gecikmeliIadeEdildi)
                            {
                                <span class="badge bg-danger">
                                    @gecikmeliIadeGunSayisi gün gecikmeli iade
                                </span>
                            }
                            else if (item.TeslimEdildiMi)
                            {
                                <span class="badge bg-success">
                                    Zamanında İade Edildi
                                </span>
                            }
                            else if (geciktiMi)
                            {
                                <span class="badge bg-danger">
                                    @gecikmeGunSayisi gün gecikti
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Ödünçte
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex flex-wrap gap-1">

                                @if (!item.TeslimEdildiMi)
                                {
                                    <form asp-action="IadeEt"
                                          asp-route-id="@item.OduncId"
                                          method="post"
                                          class="d-inline">

                                        <button type="submit"
                                                class="btn btn-success btn-sm"
                                                onclick="return confirm('Kitap iade edilsin mi?')">
                                            İade Et
                                        </button>
                                    </form>
                                }

                                <a asp-action="Details"
                                   asp-route-id="@item.OduncId"
                                   class="btn btn-info btn-sm">
                                    Detay
                                </a>

                                @if (item.TeslimEdildiMi &&
                                     !gecikmeliIadeEdildi)
                                {
                                    <a asp-action="Delete"
                                       asp-route-id="@item.OduncId"
                                       class="btn btn-danger btn-sm">
                                        Sil
                                    </a>
                                }
                                else if (gecikmeliIadeEdildi)
                                {
                                    <span class="badge bg-secondary align-self-center">
                                        Kayıt korunuyor
                                    </span>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}