@model IEnumerable<KutuphaneOtomasyonu.Models.OduncIslemleri>

@{
    ViewData["Title"] = "Ödünç İşlemleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ödünç İşlemleri</h1>

    <a asp-action="Create" class="btn btn-primary">
        Yeni Ödünç İşlemi
    </a>
</div>

@if (TempData["BasariliMesaj"] != null)
{
    <div class="alert alert-success">
        @TempData["BasariliMesaj"]
    </div>
}

@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">
        @TempData["HataMesaji"]
    </div>
}

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Kitap</th>
            <th>Üye</th>
            <th>Veriliş Tarihi</th>
            <th>Son Teslim Tarihi</th>
            <th>İade Tarihi</th>
            <th>Ceza</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Kitap?.Baslik</td>
                <td>@item.Uye?.AdSoyad</td>

                <td>
                    @item.VerilisTarihi.ToString("dd.MM.yyyy")
                </td>

                <td>
                    @item.SonTeslimTarihi.ToString("dd.MM.yyyy")
                </td>

                <td>
                    @if (item.IadeTarihi.HasValue)
                    {
                        @item.IadeTarihi.Value.ToString("dd.MM.yyyy")
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>

                <td>
                    @item.CezaTutari.ToString("N2") TL
                </td>

                <td>
                    @if (item.TeslimEdildiMi)
                    {
                        <span class="badge bg-success">
                            İade Edildi
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Ödünçte
                        </span>
                    }
                </td>

                <td>
                    @if (!item.TeslimEdildiMi)
                    {
                        <form asp-action="IadeEt"
                              asp-route-id="@item.OduncId"
                              method="post"
                              class="d-inline">

                            <button type="submit"
                                    class="btn btn-success btn-sm"
                                    onclick="return confirm('Kitap iade edilsin mi?')">
                                İade Et
                            </button>
                        </form>
                    }

                    <a asp-action="Details"
                       asp-route-id="@item.OduncId"
                       class="btn btn-info btn-sm">
                        Detay
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.OduncId"
                       class="btn btn-danger btn-sm">
                        Sil
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>