@model KutuphaneOtomasyonu.Models.Uyeler

@{
    ViewData["Title"] = "Üye Sil";
}

<h1>Üye Sil</h1>

<div class="alert alert-danger mt-4">
    Bu üyeyi silmek istediğinizden emin misiniz?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Ad Soyad</dt>
            <dd class="col-sm-9">@Model.AdSoyad</dd>

            <dt class="col-sm-3">E-posta</dt>
            <dd class="col-sm-9">@Model.Eposta</dd>

            <dt class="col-sm-3">Telefon</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Telefon)
                    ? "-"
                    : Model.Telefon)
            </dd>

            <dt class="col-sm-3">Kayıt Tarihi</dt>
            <dd class="col-sm-9">
                @Model.KayitTarihi.ToString("dd.MM.yyyy")
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="UyeId" />

    <button type="submit" class="btn btn-danger">
        Üyeyi Sil
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Vazgeç
    </a>
</form>