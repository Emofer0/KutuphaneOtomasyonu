@model KutuphaneOtomasyonu.Models.Uyeler

@{
    ViewData["Title"] = "Üye Detayı";
}

<h1>Üye Detayı</h1>

<div class="card mt-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Ad Soyad</dt>
            <dd class="col-sm-9">@Model.AdSoyad</dd>

            <dt class="col-sm-3">E-posta</dt>
            <dd class="col-sm-9">@Model.Eposta</dd>

            <dt class="col-sm-3">Telefon</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Telefon)
                    ? "-"
                    : Model.Telefon)
            </dd>

            <dt class="col-sm-3">Kayıt Tarihi</dt>
            <dd class="col-sm-9">
                @Model.KayitTarihi.ToString("dd.MM.yyyy HH:mm")
            </dd>

            <dt class="col-sm-3">Rol</dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary">
                    @Model.Rol
                </span>
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.UyeId"
       class="btn btn-warning">
        Düzenle
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Listeye Dön
    </a>
</div>