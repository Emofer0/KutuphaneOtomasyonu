@model KutuphaneOtomasyonu.Models.Uyeler

@{
    ViewData["Title"] = "Üye Detayı";

    var toplamOduncSayisi = Model.OduncIslemleris.Count;

    var aktifOduncSayisi = Model.OduncIslemleris
        .Count(o => !o.TeslimEdildiMi);

    var gecikenSayisi = Model.OduncIslemleris
        .Count(o =>
            !o.TeslimEdildiMi &&
            o.SonTeslimTarihi.Date < DateTime.Today);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@Model.AdSoyad</h1>
        <p class="text-muted mb-0">Üye detayları</p>
    </div>

    <span class="badge bg-primary fs-5">
        @toplamOduncSayisi ödünç işlemi
    </span>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Ad Soyad</dt>
            <dd class="col-sm-9">@Model.AdSoyad</dd>

            <dt class="col-sm-3">E-posta</dt>
            <dd class="col-sm-9">@Model.Eposta</dd>

            <dt class="col-sm-3">Telefon</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Telefon)
                    ? "-"
                    : Model.Telefon)
            </dd>

            <dt class="col-sm-3">Kayıt Tarihi</dt>
            <dd class="col-sm-9">
                @Model.KayitTarihi.ToString("dd.MM.yyyy")
            </dd>

            <dt class="col-sm-3">Rol</dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary">
                    @Model.Rol
                </span>
            </dd>
        </dl>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <h5>Toplam İşlem</h5>
                <h2>@toplamOduncSayisi</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-bg-warning h-100">
            <div class="card-body">
                <h5>Şu Anda Ödünçte</h5>
                <h2>@aktifOduncSayisi</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-bg-danger h-100">
            <div class="card-body">
                <h5>Geciken</h5>
                <h2>@gecikenSayisi</h2>
            </div>
        </div>
    </div>
</div>

<h2>Ödünç İşlem Geçmişi</h2>

@if (!Model.OduncIslemleris.Any())
{
    <div class="alert alert-info">
        Bu üyenin henüz ödünç işlemi bulunmuyor.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Kitap</th>
                    <th>Veriliş Tarihi</th>
                    <th>Son Teslim Tarihi</th>
                    <th>İade Tarihi</th>
                    <th>Ceza</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var islem in Model.OduncIslemleris
                    .OrderByDescending(o => o.VerilisTarihi))
                {
                    var geciktiMi =
                        !islem.TeslimEdildiMi &&
                        islem.SonTeslimTarihi.Date < DateTime.Today;

                    var gecikmeGunSayisi = geciktiMi
                        ? (DateTime.Today -
                           islem.SonTeslimTarihi.Date).Days
                        : 0;

                    var guncelCeza = geciktiMi
                        ? gecikmeGunSayisi * 5
                        : islem.CezaTutari;

                    <tr class="@(geciktiMi ? "table-danger" : "")">
                        <td>
                            <a asp-controller="Kitaplar"
                               asp-action="Details"
                               asp-route-id="@islem.KitapId">
                                @islem.Kitap?.Baslik
                            </a>
                        </td>

                        <td>
                            @islem.VerilisTarihi.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @islem.SonTeslimTarihi.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @(islem.IadeTarihi?.ToString("dd.MM.yyyy") ?? "-")
                        </td>

                        <td>
                            @guncelCeza.ToString("N2") TL
                        </td>

                        <td>
                            @if (islem.TeslimEdildiMi)
                            {
                                <span class="badge bg-success">
                                    İade Edildi
                                </span>
                            }
                            else if (geciktiMi)
                            {
                                <span class="badge bg-danger">
                                    @gecikmeGunSayisi gün gecikti
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Ödünçte
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-controller="OduncIslemleri"
                               asp-action="Details"
                               asp-route-id="@islem.OduncId"
                               class="btn btn-info btn-sm">
                                Detay
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-4">
    <a asp-action="Edit"
       asp-route-id="@Model.UyeId"
       class="btn btn-warning">
        Üyeyi Düzenle
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Listeye Dön
    </a>
</div>