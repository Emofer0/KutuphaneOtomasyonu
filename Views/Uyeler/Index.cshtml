@model IEnumerable<KutuphaneOtomasyonu.Models.Uyeler>

@{
    ViewData["Title"] = "Üyeler";
    string arama = Context.Request.Query["arama"].ToString();
}

<div class="container-fluid px-4 py-4">

    @if (TempData["Basarili"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Basarili"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Hata"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Üyeler</h1>

            <p class="text-muted mb-0">
                Kütüphane üyelerini görüntüleyebilir ve yönetebilirsiniz.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            Yeni Üye Ekle
        </a>
    </div>

    <form asp-action="Index"
          method="get"
          class="mb-4">

        <div class="input-group">
            <input type="text"
                   name="arama"
                   value="@arama"
                   class="form-control"
                   placeholder="Ad, e-posta veya telefon ara..." />

            <button type="submit"
                    class="btn btn-primary">
                Ara
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Temizle
            </a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Üye bulunamadı.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">

                <thead class="table-dark">
                    <tr>
                        <th>Üye ID</th>
                        <th>Ad Soyad</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th>Kayıt Tarihi</th>
                        <th>Rol</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(!item.AktifMi ? "table-secondary" : "")">

                            <td>
                                <span class="badge bg-primary">
                                    #@item.UyeId
                                </span>
                            </td>

                            <td>
                                <strong>@item.AdSoyad</strong>
                            </td>

                            <td>
                                @item.Eposta
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(item.Telefon))
                                {
                                    <span class="text-muted">-</span>
                                }
                                else
                                {
                                    @item.Telefon
                                }
                            </td>

                            <td>
                                @item.KayitTarihi.ToString("dd.MM.yyyy")
                            </td>

                            <td>
                                @if (item.Rol == "Admin")
                                {
                                    <span class="badge bg-danger">
                                        Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Üye
                                    </span>
                                }
                            </td>

                            <td>
                                @if (item.AktifMi)
                                {
                                    <span class="badge bg-success">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">
                                        Pasif
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.UyeId"
                                       class="btn btn-sm btn-warning">
                                        Düzenle
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.UyeId"
                                       class="btn btn-sm btn-info">
                                        Detay
                                    </a>

                                    @if (item.Rol != "Admin")
                                    {
                                        @if (item.AktifMi)
                                        {
                                            <form asp-action="PasifeAl"
                                                  method="post"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.UyeId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('@item.AdSoyad adlı üyeyi pasife almak istediğinize emin misiniz?')">
                                                    Pasife Al
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="AktifEt"
                                                  method="post"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.UyeId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success"
                                                        onclick="return confirm('@item.AdSoyad adlı üyeyi yeniden aktif etmek istediğinize emin misiniz?')">
                                                    Aktif Et
                                                </button>
                                            </form>
                                        }
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-muted">
            Toplam <strong>@Model.Count()</strong> üye gösteriliyor.
        </div>
    }
</div>