@model IEnumerable<KutuphaneOtomasyonu.Models.OduncIslemleri>

@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="card border-0 mb-4"
     style="background: linear-gradient(135deg, #11233d, #264c70);">
    <div class="card-body p-4 p-lg-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark mb-3">
                    Yönetim Paneli
                </span>

                <h1 class="text-white mb-2">
                    Hoş geldin, @User.Identity?.Name
                </h1>

                <p class="text-white-50 mb-0">
                    Kütüphane durumunu, ödünç işlemlerini ve geciken
                    kitapları buradan takip edebilirsin.
                </p>
            </div>

            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <div class="text-white-50">
                    Bugünün tarihi
                </div>

                <div class="fs-4 fw-bold text-white">
                    @DateTime.Today.ToString("dd.MM.yyyy")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-sm-6 col-xl-3">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="opacity-75 mb-2">
                            Katalog
                        </div>

                        <h5>Kitap Çeşidi</h5>
                        <h2 class="display-6">@ViewBag.ToplamKitap</h2>
                    </div>

                    <span class="fs-2 opacity-50">K</span>
                </div>
            </div>

            <div class="card-footer">
                <a asp-controller="Kitaplar"
                   asp-action="Index"
                   class="text-white text-decoration-none">
                    Kitapları görüntüle →
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card text-bg-success h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="opacity-75 mb-2">
                            Kullanıcılar
                        </div>

                        <h5>Toplam Üye</h5>
                        <h2 class="display-6">@ViewBag.ToplamUye</h2>
                    </div>

                    <span class="fs-2 opacity-50">Ü</span>
                </div>
            </div>

            <div class="card-footer">
                <a asp-controller="Uyeler"
                   asp-action="Index"
                   class="text-white text-decoration-none">
                    Üyeleri görüntüle →
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card text-bg-warning h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="opacity-75 mb-2">
                            Aktif işlemler
                        </div>

                        <h5>Ödünçte</h5>
                        <h2 class="display-6">@ViewBag.OdunctekiKitap</h2>
                    </div>

                    <span class="fs-2 opacity-50">Ö</span>
                </div>
            </div>

            <div class="card-footer">
                <a asp-controller="OduncIslemleri"
                   asp-action="Index"
                   asp-route-durum="oduncte"
                   class="text-dark text-decoration-none">
                    Aktif işlemleri görüntüle →
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card text-bg-danger h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="opacity-75 mb-2">
                            Dikkat gereken
                        </div>

                        <h5>Geciken</h5>
                        <h2 class="display-6">@ViewBag.GecikenKitap</h2>
                    </div>

                    <span class="fs-2 opacity-50">!</span>
                </div>
            </div>

            <div class="card-footer">
                <a asp-controller="OduncIslemleri"
                   asp-action="Index"
                   asp-route-durum="geciken"
                   class="text-white text-decoration-none">
                    Gecikenleri görüntüle →
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="mb-1">Son Ödünç İşlemleri</h2>

                <p class="text-muted mb-0">
                    En son gerçekleştirilen beş işlem
                </p>
            </div>

            <a asp-controller="OduncIslemleri"
               asp-action="Index"
               class="btn btn-outline-primary">
                Tümünü Gör
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                Henüz ödünç işlemi bulunmuyor.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Kitap</th>
                            <th>Üye</th>
                            <th>Veriliş Tarihi</th>
                            <th>Son Teslim</th>
                            <th>Durum</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var geciktiMi =
                                !item.TeslimEdildiMi &&
                                item.SonTeslimTarihi.Date <
                                DateTime.Today;

                            <tr class="@(geciktiMi
                                ? "table-danger"
                                : "")">

                                <td>
                                    <a asp-controller="Kitaplar"
                                       asp-action="Details"
                                       asp-route-id="@item.KitapId">
                                        @item.Kitap?.Baslik
                                    </a>
                                </td>

                                <td>
                                    <a asp-controller="Uyeler"
                                       asp-action="Details"
                                       asp-route-id="@item.UyeId">
                                        @item.Uye?.AdSoyad
                                    </a>
                                </td>

                                <td>
                                    @item.VerilisTarihi.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    @item.SonTeslimTarihi.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    @if (item.TeslimEdildiMi)
                                    {
                                        <span class="badge bg-success">
                                            İade Edildi
                                        </span>
                                    }
                                    else if (geciktiMi)
                                    {
                                        <span class="badge bg-danger">
                                            Gecikti
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Ödünçte
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="col-xl-3">
        <h2 class="mb-3">Hızlı İşlemler</h2>

        <div class="card">
            <div class="card-body d-grid gap-3">
                <a asp-controller="OduncIslemleri"
                   asp-action="Create"
                   class="btn btn-primary">
                    Yeni Ödünç İşlemi
                </a>

                <a asp-controller="Kitaplar"
                   asp-action="Create"
                   class="btn btn-outline-primary">
                    Yeni Kitap Ekle
                </a>

                <a asp-controller="Uyeler"
                   asp-action="Create"
                   class="btn btn-outline-primary">
                    Yeni Üye Ekle
                </a>

                <a asp-controller="Yazarlar"
                   asp-action="Create"
                   class="btn btn-outline-secondary">
                    Yeni Yazar Ekle
                </a>

                <a asp-controller="Kategoriler"
                   asp-action="Create"
                   class="btn btn-outline-secondary">
                    Yeni Kategori Ekle
                </a>
            </div>
        </div>
    </div>
</div>