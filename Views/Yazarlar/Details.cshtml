@model KutuphaneOtomasyonu.Models.Yazarlar

@{
    ViewData["Title"] = "Yazar Detayı";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@Model.AdSoyad</h1>
        <p class="text-muted mb-0">Yazar detayları</p>
    </div>

    <span class="badge bg-primary fs-5">
        @Model.Kitaplars.Count kitap
    </span>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Yazar Adı</dt>
            <dd class="col-sm-9">@Model.AdSoyad</dd>

            <dt class="col-sm-3">Kitap Çeşidi Sayısı</dt>
            <dd class="col-sm-9">
                @Model.Kitaplars.Count
            </dd>

            <dt class="col-sm-3">Toplam Kitap Adedi</dt>
            <dd class="col-sm-9">
                @Model.Kitaplars.Sum(k => k.ToplamAdet)
            </dd>

            <dt class="col-sm-3">Mevcut Kitap Adedi</dt>
            <dd class="col-sm-9">
                @Model.Kitaplars.Sum(k => k.MevcutAdet)
            </dd>
        </dl>
    </div>
</div>

<h2>Yazara Ait Kitaplar</h2>

@if (!Model.Kitaplars.Any())
{
    <div class="alert alert-info">
        Bu yazara ait kitap bulunmuyor.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Kitap</th>
                    <th>Kategori</th>
                    <th>ISBN</th>
                    <th>Raf</th>
                    <th>Toplam</th>
                    <th>Mevcut</th>
                    <th>Durum</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var kitap in Model.Kitaplars
                    .OrderBy(k => k.Baslik))
                {
                    <tr>
                        <td>
                            <a asp-controller="Kitaplar"
                               asp-action="Details"
                               asp-route-id="@kitap.KitapId">
                                @kitap.Baslik
                            </a>
                        </td>

                        <td>@kitap.Kategori?.Baslik</td>
                        <td>@kitap.Isbn</td>
                        <td>@kitap.RafKonumu</td>
                        <td>@kitap.ToplamAdet</td>
                        <td>@kitap.MevcutAdet</td>

                        <td>
                            @if (kitap.MevcutAdet > 0)
                            {
                                <span class="badge bg-success">
                                    Mevcut
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Stokta Yok
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.YazarId"
       class="btn btn-warning">
        Yazarı Düzenle
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Listeye Dön
    </a>
</div>