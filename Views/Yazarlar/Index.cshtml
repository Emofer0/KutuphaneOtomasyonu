@model IEnumerable<KutuphaneOtomasyonu.Models.Yazarlar>

@{
    ViewData["Title"] = "Yazarlar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Yazarlar</h1>

    <a asp-action="Create" class="btn btn-primary">
        Yeni Yazar Ekle
    </a>
</div>

@if (TempData["BasariliMesaj"] != null)
{
    <div class="alert alert-success">
        @TempData["BasariliMesaj"]
    </div>
}

@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">
        @TempData["HataMesaji"]
    </div>
}

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text"
               name="arama"
               value="@ViewBag.Arama"
               class="form-control"
               placeholder="Yazar adı ara..." />

        <button type="submit" class="btn btn-primary">
            Ara
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Temizle
        </a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        Arama kriterine uygun yazar bulunamadı.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Yazar Adı</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AdSoyad</td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.YazarId"
                               class="btn btn-warning btn-sm">
                                Düzenle
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.YazarId"
                               class="btn btn-info btn-sm">
                                Detay
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.YazarId"
                               class="btn btn-danger btn-sm">
                                Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
