@model KutuphaneOtomasyonu.Models.Yazarlar

@{
    ViewData["Title"] = "Yazar Düzenle";
}

<h1>Yazar Düzenle</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="YazarId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="AdSoyad" class="form-label">
                    Yazar Adı
                </label>

                <input asp-for="AdSoyad" class="form-control" />

                <span asp-validation-for="AdSoyad"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Kaydet
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Listeye Dön
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}