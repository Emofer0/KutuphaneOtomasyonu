@model KutuphaneOtomasyonu.ViewModels.GirisViewModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h1 class="h3">Kütüphane Otomasyonu</h1>

                    <p class="text-muted">
                        Hesabınızla giriş yapın
                    </p>
                </div>

                <form asp-action="Giris"
                      asp-route-returnUrl="@ViewBag.ReturnUrl"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Eposta"
                               class="form-label"></label>

                        <input asp-for="Eposta"
                               type="email"
                               class="form-control"
                               placeholder="ornek@email.com"
                               autocomplete="email" />

                        <span asp-validation-for="Eposta"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sifre"
                               class="form-label"></label>

                        <input asp-for="Sifre"
                               class="form-control"
                               placeholder="Şifreniz"
                               autocomplete="current-password" />

                        <span asp-validation-for="Sifre"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="BeniHatirla"
                               class="form-check-input" />

                        <label asp-for="BeniHatirla"
                               class="form-check-label"></label>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Giriş Yap
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}