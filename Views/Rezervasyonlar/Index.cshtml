@model IEnumerable<KutuphaneOtomasyonu.Models.Rezervasyonlar>

@{
    ViewData["Title"] = User.IsInRole("Admin")
        ? "Rezervasyonlar"
        : "Rezervasyonlarım";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">
                @(User.IsInRole("Admin")
                    ? "Kitap Rezervasyonları"
                    : "Rezervasyonlarım")
            </h1>

            <p class="text-muted mb-0">
                @if (User.IsInRole("Admin"))
                {
                    <span>Üyelerin kitap rezervasyonlarını yönetebilirsiniz.</span>
                }
                else
                {
                    <span>Ayırttığınız kitapları buradan takip edebilirsiniz.</span>
                }
            </p>
        </div>

        <div class="d-flex gap-2">

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Yeni Rezervasyon
        </a>
    }

    <a asp-controller="Kitaplar"
       asp-action="Index"
       class="btn btn-outline-primary">
        Kitaplara Dön
    </a>

</div>
    </div>

    @if (TempData["Basarili"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Basarili"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Hata"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Henüz bir rezervasyon bulunmuyor.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Kitap</th>
                        <th>Yazar</th>

                        @if (User.IsInRole("Admin"))
                        {
                            <th>Üye</th>
                        }

                        <th>Rezervasyon Tarihi</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var rezervasyon in Model)
                    {
                        <tr>
                            <td>
                                <strong>
                                    @rezervasyon.Kitap.Baslik
                                </strong>
                            </td>

                            <td>
                                @(rezervasyon.Kitap.Yazar?.AdSoyad ?? "-")
                            </td>

                            @if (User.IsInRole("Admin"))
                            {
                                <td>
                                    @rezervasyon.Uye.AdSoyad
                                </td>
                            }

                            <td>
                                @rezervasyon.RezervasyonTarihi.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>
                                @if (rezervasyon.Durum == "Bekliyor")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Bekliyor
                                    </span>
                                }
                                else if (rezervasyon.Durum == "Tamamlandı")
                                {
                                    <span class="badge bg-success">
                                        Tamamlandı
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        İptal
                                    </span>
                                }
                            </td>

                            <td>
                                @if (rezervasyon.Durum == "Bekliyor")
                                {
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-action="Tamamla"
                                              method="post"
                                              class="d-inline">
                                            <input type="hidden"
                                                   name="id"
                                                   value="@rezervasyon.RezervasyonId" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-success"
                                                    onclick="return confirm('Rezervasyon tamamlandı olarak işaretlensin mi?')">
                                                Tamamla
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="Iptal"
                                          method="post"
                                          class="d-inline">
                                        <input type="hidden"
                                               name="id"
                                               value="@rezervasyon.RezervasyonId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Rezervasyonu iptal etmek istediğinize emin misiniz?')">
                                            İptal Et
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">İşlem yok</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>