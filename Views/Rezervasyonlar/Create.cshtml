@{
    ViewData["Title"] = "Yeni Rezervasyon";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow">

                <div class="card-header text-white p-4"
                     style="background-color:#102a4c;">

                    <h2 class="mb-1">
                        Yeni Rezervasyon Oluştur
                    </h2>

                    <p class="mb-0 opacity-75">
                        Bir üye ve stokta olmayan kitabı seçin.
                    </p>
                </div>

                <div class="card-body p-4">

                    @if (TempData["Hata"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @TempData["Hata"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>
                        </div>
                    }

                    <form asp-action="Create"
                          method="post">

                        <div class="mb-4">
                            <label for="UyeId"
                                   class="form-label fw-semibold">
                                Üye
                            </label>

                            <select id="UyeId"
                                    name="uyeId"
                                    class="form-select"
                                    asp-items="ViewBag.UyeId"
                                    required>

                                <option value="">
                                    Üye seçiniz
                                </option>
                            </select>

                            <div class="form-text">
                                Yalnızca aktif üyeler gösterilir.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="KitapId"
                                   class="form-label fw-semibold">
                                Kitap
                            </label>

                            <select id="KitapId"
                                    name="kitapId"
                                    class="form-select"
                                    asp-items="ViewBag.KitapId"
                                    required>

                                <option value="">
                                    Kitap seçiniz
                                </option>
                            </select>

                            <div class="form-text">
                                Yalnızca mevcut adedi sıfır olan kitaplar gösterilir.
                            </div>
                        </div>

                        <div class="alert alert-info">
                            Aynı üye ve kitap için birden fazla bekleyen
                            rezervasyon oluşturulamaz.
                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Vazgeç
                            </a>

                            <button type="submit"
                                    class="btn btn-primary"
                                    onclick="return confirm('Rezervasyon oluşturulsun mu?')">
                                Rezervasyon Oluştur
                            </button>

                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>