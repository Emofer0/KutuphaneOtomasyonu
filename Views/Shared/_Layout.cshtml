<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Kütüphane Otomasyonu
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/KutuphaneOtomasyonu.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid px-4">

                <a class="navbar-brand fw-bold d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="d-inline-flex align-items-center justify-content-center
                                 text-white rounded me-2"
                          style="width:42px;
                                 height:42px;
                                 background-color:#102a4c;">
                        K
                    </span>

                    Kütüphane Otomasyonu
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#anaMenu"
                        aria-controls="anaMenu"
                        aria-expanded="false"
                        aria-label="Menüyü aç">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="anaMenu">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Ana Sayfa
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Kitaplar"
                                       asp-action="Index">
                                        Kitaplar
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Yazarlar"
                                       asp-action="Index">
                                        Yazarlar
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Kategoriler"
                                       asp-action="Index">
                                        Kategoriler
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Uyeler"
                                       asp-action="Index">
                                        Üyeler
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="OduncIslemleri"
                                       asp-action="Index">
                                        Ödünç İşlemleri
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Rezervasyonlar"
                                       asp-action="Index">
                                        Rezervasyonlar
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Uye"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Kitaplar"
                                       asp-action="Index">
                                        Kitaplar
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Hesabim"
                                       asp-action="Islemlerim">
                                        İşlemlerim
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Rezervasyonlar"
                                       asp-action="Index">
                                        Rezervasyonlarım
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center"
                                   href="#"
                                   id="hesapMenusu"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <span class="me-2">
                                        Merhaba,
                                        <strong>
                                            @(User.Identity.Name ?? "Kullanıcı")
                                        </strong>
                                    </span>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-danger">
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            Üye
                                        </span>
                                    }
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow"
                                    aria-labelledby="hesapMenusu">

                                    <li>
                                        <h6 class="dropdown-header">
                                            Hesap İşlemleri
                                        </h6>
                                    </li>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Home"
                                               asp-action="Index">
                                                Yönetim Paneli
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Uye"))
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Hesabim"
                                               asp-action="SifreDegistir">
                                                Şifre Değiştir
                                            </a>
                                        </li>
                                    }

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <form asp-controller="Hesap"
                                              asp-action="Cikis"
                                              method="post">
                                            <button type="submit"
                                                    class="dropdown-item text-danger fw-semibold">
                                                Çıkış Yap
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary"
                                   asp-controller="Hesap"
                                   asp-action="Giris">
                                    Giriş Yap
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main"
          class="pb-5">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted bg-white">
        <div class="container py-3">
            &copy; @DateTime.Now.Year - Kütüphane Otomasyonu
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )
</body>
</html>