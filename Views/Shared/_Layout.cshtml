<<!DOCTYPE html>

<html lang="tr">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Kütüphane Otomasyonu
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/KutuphaneOtomasyonu.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid">
                @if (User.IsInRole("Admin"))
                {
                    <a class="navbar-brand"
                       asp-controller="Home"
                       asp-action="Index">
                        Kütüphane Otomasyonu
                    </a>
                }
                else
                {
                    <a class="navbar-brand"
                       asp-controller="Kitaplar"
                       asp-action="Index">
                        Kütüphane Otomasyonu
                    </a>
                }

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#anaMenu"
                        aria-controls="anaMenu"
                        aria-expanded="false"
                        aria-label="Menüyü aç">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="anaMenu">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto">
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Ana Sayfa
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Kitaplar"
                                   asp-action="Index">
                                    Kitaplar
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Yazarlar"
                                       asp-action="Index">
                                        Yazarlar
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Kategoriler"
                                       asp-action="Index">
                                        Kategoriler
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Uyeler"
                                       asp-action="Index">
                                        Üyeler
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="OduncIslemleri"
                                       asp-action="Index">
                                        Ödünç İşlemleri
                                    </a>
                                </li>
                            }
                        </ul>

                        <ul class="navbar-nav ms-auto align-items-lg-center">
                            <li class="nav-item me-lg-3">
                                <span class="nav-link">
                                    Merhaba,
                                    <strong>@User.Identity.Name</strong>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-danger ms-1">
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary ms-1">
                                            Üye
                                        </span>
                                    }
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Hesap"
                                      asp-action="Cikis"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-outline-danger">
                                        Çıkış Yap
                                    </button>
                                </form>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a asp-controller="Hesap"
                                   asp-action="Giris"
                                   class="btn btn-outline-primary">
                                    Giriş Yap
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year -
            Kütüphane Otomasyonu
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)
</body>
</html>